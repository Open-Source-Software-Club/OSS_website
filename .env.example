# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Public / Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase (Server Only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Automation / Cron Secrets
CRON_SECRET=your-cron-secret-placeholder

# GitHub Integration (App / Webhooks)
GITHUB_APP_ID=your-github-app-id-placeholder
GITHUB_APP_PRIVATE_KEY="your-github-app-private-key-placeholder"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-placeholder

# CI / Build Flag
SKIP_ENV_VALIDATION=1
