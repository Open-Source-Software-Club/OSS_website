# Editor settings that match the repository gate
# (scripts/checks/check-text-hygiene.sh), so most editors get them right
# without any setup: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown is trimmed too. The gate does allow exactly two trailing spaces as a
# hard break, but nothing in this repository uses one, and a stray space is the
# far more common mistake. Use a trailing backslash for a line break instead.
