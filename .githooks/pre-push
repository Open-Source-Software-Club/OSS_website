#!/usr/bin/env bash
# ==============================================================================
# .githooks/pre-push
#
# The last checkpoint before code leaves the contributor's machine and becomes
# visible to the world (and, on main, to production).
#
# Responsibilities:
#   1. Never push straight to a protected branch (main/master/develop).
#   2. Run the full repository gate over what is about to be pushed.
#
# Install once per clone:
#   git config core.hooksPath .githooks      (or: ./scripts/install-hooks.sh)
#
# Bypass (audited, and discouraged):
#   git push --no-verify
# ==============================================================================
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

PROTECTED_BRANCHES='^(main|master|develop|staging|production)$'

# git supplies: <remote> <remote-url> on argv, and refs on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>".
REMOTE="${1:-origin}"
# $2 is the remote URL; it is accepted for completeness and deliberately unused.

blocked=0
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -z "${local_ref:-}" ] && continue

  # Deleting a remote branch is a maintainer action; still guard the name.
  target="${remote_ref#refs/heads/}"

  if [[ "$target" =~ $PROTECTED_BRANCHES ]]; then
    # A force-push to a protected branch is never legitimate from a clone that
    # has the hooks installed.
    if [ "$local_sha" = '0000000000000000000000000000000000000000' ]; then
      echo "pre-push: refusing to DELETE protected branch '$target' on $REMOTE" >&2
      blocked=1
      continue
    fi
    echo "pre-push: refusing to push directly to protected branch '$target'" >&2
    echo "            Open a pull request instead:" >&2
    echo "              git push -u origin HEAD" >&2
    echo "              gh pr create --base $target" >&2
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  exit 1
fi

# ------------------------------------------------------------------------------
# Full gate. Scope it to the commits being pushed so it is fast and relevant.
# ------------------------------------------------------------------------------
if git rev-parse --verify --quiet '@{upstream}' >/dev/null 2>&1; then
  RANGE="@{upstream}..HEAD"
else
  RANGE="HEAD~1..HEAD"
fi

bash "$REPO_ROOT/scripts/checks/check-forbidden-files.sh" || exit 1
bash "$REPO_ROOT/scripts/checks/check-secrets.sh" || exit 1
bash "$REPO_ROOT/scripts/checks/check-large-files.sh" || exit 1
bash "$REPO_ROOT/scripts/checks/check-text-hygiene.sh" || exit 1
bash "$REPO_ROOT/scripts/checks/check-lockfiles.sh" || exit 1
bash "$REPO_ROOT/scripts/checks/check-commit-msg.sh" --range "$RANGE" || exit 1

cat >&2 <<'MSG'

------------------------------------------------------------------------------
Push authorised.

Remember: everything above is also re-checked in CI
(.github/workflows/ci.yml). CI is the authoritative gate — a green local run
does not replace it.
------------------------------------------------------------------------------
MSG

exit 0
